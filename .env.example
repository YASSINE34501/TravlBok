# Database (Postgres — e.g. Neon, Supabase, or local)
# Two DIFFERENT connection strings, not the same value copy-pasted twice:
#   DATABASE_URL — the app's runtime connection. On Supabase this is the
#     pooled "Transaction" connection string (port 6543, includes
#     "?pgbouncer=true"), found in Project Settings > Database > Connection
#     string > "Transaction pooler".
#   DIRECT_URL — used only by `prisma migrate deploy`/Studio, never by the
#     running app. Pgbouncer's transaction-pooling mode doesn't support what
#     Prisma Migrate needs, so this must be the "Session pooler" connection
#     string instead (same page, port 5432, no pgbouncer flag).
# If your provider has no pooler at all, both may be the same value.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Email (Resend) — used for verification, password reset, booking notifications
RESEND_API_KEY=""
EMAIL_FROM="TravlBok <no-reply@travlbok.com>"

# Object storage (Supabase Storage) — used for property photos, vehicle
# photos, avatars, promo materials, and partner legal documents. Buckets
# (property-images, vehicle-images, avatars, promo-materials,
# partner-documents, booking-documents) are created once in the Supabase
# dashboard, not via env vars — see the storage architecture report for
# exact bucket names/policies. SUPABASE_SERVICE_ROLE_KEY is server-only:
# never expose it to client-side code. Required in production — falls back
# to local disk (public/uploads) only when NODE_ENV isn't "production";
# uploads fail with a clear error in production if this is left unset.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Payments — all optional. Bank transfer/Manual/Cash-at-property work with no
# configuration. Stripe/PayPal run in a clearly-labeled sandbox/mock mode
# (no network calls) until real test-mode credentials are set here.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# Shared secret required by /api/cron/retry-failed-payments,
# /api/cron/channel-auto-sync, and /api/cron/booking-reminders. Vercel Cron
# sends this automatically as "Authorization: Bearer <value>" once this env
# var is set on the project — no extra config needed. An external scheduler
# may instead send it as the legacy "x-cron-secret" header.
CRON_SECRET=""

# Channel Manager — encrypts connected channels' stored API credentials
# (AES-256-GCM). Optional: falls back to deriving a key from AUTH_SECRET if
# unset, so this works out of the box in development. Set a dedicated
# 32+ byte random value in production.
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=""

# App
# NEXT_PUBLIC_APP_URL must include the protocol (https://...) — used to
# build absolute URLs in email links and metadata; an unset or malformed
# value (e.g. missing "https://") will throw at render time.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dev-only sandbox hotel/car/flight offers for local testing of the
# marketplace distribution layer. Leave unset. Hard-disabled in production
# in code regardless of this value — never set it on a production deployment.
ENABLE_MOCK_DISTRIBUTION_PROVIDER=""
