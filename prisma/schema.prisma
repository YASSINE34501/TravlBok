enum RoomOperationalStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  DIRTY
  CLEANING
  INSPECTED
  READY
  OUT_OF_SERVICE
  MAINTENANCE
}

enum HousekeepingTaskType {
  CLEANING
  INSPECTION
  TURNDOWN
  DEEP_CLEAN
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  INSPECTED
  REOPENED
}

enum TaskPriority {
