generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// ENUMS
// =========================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  HOTEL_OWNER
  HOTEL_MANAGER
  RECEPTIONIST
  HOUSEKEEPING_STAFF
  HOTEL_ACCOUNTANT
  CAR_RENTAL_OWNER
  CAR_RENTAL_STAFF
  TRAVEL_AGENCY
  TOUR_PROVIDER
  AFFILIATE_PARTNER
  CUSTOMER
  SUPPORT_AGENT
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}

enum OrganizationType {
  HOTEL
  CAR_RENTAL
  TRAVEL_AGENCY
  TOUR_PROVIDER
  AFFILIATE
}

enum VerificationStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  PUBLISHED
  UNPUBLISHED
}

enum OrgMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum CurrencyCode {
  MAD
  EUR
  USD
}

enum RateSource {
  MANUAL
  AUTOMATIC
}

enum MediaType {
  IMAGE
  VIDEO
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  LPG
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum MileagePolicy {
  UNLIMITED
  LIMITED
}

enum FuelPolicy {
  FULL_TO_FULL
  FULL_TO_EMPTY
  SAME_TO_SAME
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  INACTIVE
}

enum ReservationType {
  HOTEL
  CAR
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  PAY_AT_PROPERTY
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponScope {
  ALL
  HOTEL
  CAR
  SUBSCRIPTION
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum ReviewTargetType {
  HOTEL
  VEHICLE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CategoryType {
  HOTEL_TYPE
  VEHICLE_CATEGORY
}

enum AmenityCategory {
  HOTEL
  ROOM
  VEHICLE
  GENERAL
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
}

enum UploadPurpose {
  LEGAL_DOCUMENT
  PROPERTY_PHOTO
  PROPERTY_VIDEO
  ROOM_PHOTO
  ROOM_VIDEO
  VEHICLE_PHOTO
  VEHICLE_VIDEO
  AVATAR
  PROMO_MATERIAL
  OTHER
}

// =========================================================================
// IDENTITY & ACCESS
// =========================================================================

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String?
  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?
  locale        String     @default("en")
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(PENDING_VERIFICATION)
  lastLoginAt   DateTime?

  // Security (Phase 3): TOTP 2FA, and a JWT-revocation timestamp — since
  // sessions here are JWT-strategy (not DB-backed), "sign out everywhere"
  // works by comparing each token's issued-at against this field rather than
  // deleting Session rows (see src/lib/rbac.ts's getCurrentUser).
  twoFactorEnabled      Boolean   @default(false)
  twoFactorSecret       String?
  twoFactorBackupCodes  String[]  @default([])
  sessionsInvalidatedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts                Account[]
  sessions                Session[]
  organizationMemberships OrganizationMember[]
  auditLogs               AuditLog[]
  reservations            Reservation[]
  reviews                 Review[]
  uploadedFiles           UploadedFile[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  notifications           Notification[]
  createdPricingRules     PricingRule[]            @relation("PricingRuleCreatedBy")
  approvedPricingRules    PricingRule[]            @relation("PricingRuleApprovedBy")
  createdApiKeys          ApiKey[]

  @@index([role])
  @@index([status])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =========================================================================
// MULTI-TENANT ORGANIZATIONS
// =========================================================================

model Organization {
  id                 String             @id @default(uuid())
  type               OrganizationType
  legalName          String
  displayName        String
  registrationNumber String?
  taxId              String?
  countryId          String?
  cityId             String?
  address            String?
  phone              String?
  email              String?
  website            String?
  baseCurrency       CurrencyCode       @default(MAD)
  logoUrl            String?
  verificationStatus VerificationStatus @default(DRAFT)
  rejectionReason    String?
  changeRequestNotes String?
  submittedAt        DateTime?
  reviewedByUserId   String?
  reviewedAt         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  country Country? @relation(fields: [countryId], references: [id])
  city    City?    @relation(fields: [cityId], references: [id])

  members            OrganizationMember[]
  hotels             Hotel[]
  carBranches        CarBranch[]
  vehicles           Vehicle[]
  reservations       Reservation[]
  uploadedFiles      UploadedFile[]
  auditLogs          AuditLog[]
  coupons            Coupon[]
  commissionRules    CommissionRule[]
  subscription       Subscription?
  payments           Payment[]
  invoices           Invoice[]
  affiliate          Affiliate?
  channelConnections ChannelConnection[]
  apiKeys            ApiKey[]

  @@index([type])
  @@index([verificationStatus])
}

model OrganizationMember {
  id              String          @id @default(uuid())
  organizationId  String
  userId          String
  role            Role
  status          OrgMemberStatus @default(ACTIVE)
  invitedByUserId String?
  joinedAt        DateTime        @default(now())
  // Car-rental "branch staff permissions" — null means unscoped (sees/manages
  // every branch in the organization, e.g. owners/managers); set to restrict a
  // CAR_RENTAL_STAFF member to a single branch's vehicles.
  branchId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       CarBranch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([branchId])
}

// =========================================================================
// FILES & AUDIT
// =========================================================================

model UploadedFile {
  id               String        @id @default(uuid())
  url              String
  key              String
  filename         String
  mimeType         String
  sizeBytes        Int
  purpose          UploadPurpose
  organizationId   String?
  uploadedByUserId String

  createdAt DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  uploadedBy   User          @relation(fields: [uploadedByUserId], references: [id])

  @@index([organizationId])
  @@index([purpose])
}

model AuditLog {
  id             String  @id @default(uuid())
  actorUserId    String?
  organizationId String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now())

  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([organizationId])
  @@index([createdAt])
}

// =========================================================================
// LOCALIZATION, GEOGRAPHY, CURRENCY
// =========================================================================

model Translation {
  id        String @id @default(uuid())
  namespace String
  key       String
  locale    String
  value     String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([namespace, key, locale])
}

model Country {
  id   String @id @default(uuid())
  code String @unique
  name Json

  createdAt DateTime @default(now())

  cities        City[]
  organizations Organization[]
  hotels        Hotel[]
  carBranches   CarBranch[]
}

model City {
  id        String @id @default(uuid())
  countryId String
  name      Json

  createdAt DateTime @default(now())

  country       Country        @relation(fields: [countryId], references: [id], onDelete: Cascade)
  organizations Organization[]
  hotels        Hotel[]
  carBranches   CarBranch[]

  @@index([countryId])
}

model ExchangeRate {
  id              String       @id @default(uuid())
  baseCurrency    CurrencyCode
  targetCurrency  CurrencyCode
  rate            Decimal      @db.Decimal(18, 8)
  source          RateSource   @default(MANUAL)
  effectiveAt     DateTime     @default(now())
  createdByUserId String?

  createdAt DateTime @default(now())

  @@index([baseCurrency, targetCurrency, effectiveAt])
}

model GlobalSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// =========================================================================
// TAXONOMIES: AMENITIES, CATEGORIES, CANCELLATION POLICIES, COUPONS, COMMISSIONS
// =========================================================================

model Amenity {
  id       String          @id @default(uuid())
  code     String          @unique
  category AmenityCategory
  icon     String?
  name     Json

  createdAt DateTime @default(now())

  hotels    Hotel[]    @relation("HotelAmenities")
  roomTypes RoomType[] @relation("RoomTypeAmenities")
}

model Category {
  id   String       @id @default(uuid())
  type CategoryType
  code String
  name Json

  createdAt DateTime @default(now())

  hotels   Hotel[]
  vehicles Vehicle[]

  @@unique([type, code])
}

model CancellationPolicy {
  id          String @id @default(uuid())
  name        Json
  description Json
  rules       Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomTypes RoomType[]
}

model Coupon {
  id               String        @id @default(uuid())
  code             String        @unique
  type             CouponType
  value            Decimal       @db.Decimal(12, 2)
  currency         CurrencyCode?
  maxDiscount      Decimal?      @db.Decimal(12, 2)
  minBookingAmount Decimal?      @db.Decimal(12, 2)
  scope            CouponScope   @default(ALL)
  organizationId   String?
  validFrom        DateTime
  validTo          DateTime
  usageLimit       Int?
  usageCount       Int           @default(0)
  perUserLimit     Int?
  status           CouponStatus  @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations  Reservation[]
  subscriptions Subscription[]

  @@index([organizationId])
}

model CommissionRule {
  id             String          @id @default(uuid())
  organizationId String?
  serviceType    ReservationType
  type           CommissionType
  value          Decimal         @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, serviceType])
}

// =========================================================================
// SUBSCRIPTIONS
// =========================================================================

enum SubscriptionPlanTier {
  FREE
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum UsageMetric {
  PROPERTIES
  ROOMS_PER_PROPERTY
  VEHICLES
  BRANCHES
  STAFF
  STORAGE_MB
  MONTHLY_BOOKINGS
}

model SubscriptionPlan {
  id          String               @id @default(uuid())
  tier        SubscriptionPlanTier
  name        Json
  description Json?

  monthlyPrice Decimal      @db.Decimal(12, 2)
  annualPrice  Decimal      @db.Decimal(12, 2)
  currency     CurrencyCode @default(MAD)
  trialDays    Int          @default(0)

  maxProperties       Int?
  maxRoomsPerProperty Int?
  maxVehicles         Int?
  maxBranches         Int?
  maxStaff            Int?
  maxStorageMb        Int?
  maxMonthlyBookings  Int?

  featureAnalytics             Boolean @default(false)
  featurePms                   Boolean @default(false)
  featureChannelManager        Boolean @default(false)
  featureDynamicPricing        Boolean @default(false)
  featureApiAccess             Boolean @default(false)
  featureAffiliateTools        Boolean @default(false)
  featurePrioritySupport       Boolean @default(false)
  featureCustomCommissionRates Boolean @default(false)

  isCustom   Boolean @default(false)
  isArchived Boolean @default(false)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([tier])
}

model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  billingInterval    BillingInterval    @default(MONTHLY)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  gracePeriodEndsAt  DateTime?
  couponId           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  coupon       Coupon?          @relation(fields: [couponId], references: [id])
  usageRecords UsageRecord[]
  payments     Payment[]
  invoices     Invoice[]

  @@index([planId])
  @@index([status])
}

model UsageRecord {
  id             String      @id @default(uuid())
  subscriptionId String
  metric         UsageMetric
  period         DateTime    @db.Date
  value          Int

  recordedAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, metric, period])
}

// =========================================================================
// PAYMENTS
// =========================================================================

enum PaymentProviderCode {
  STRIPE
  PAYPAL
  BANK_TRANSFER
  MANUAL
  CASH_AT_PROPERTY
}

enum PaymentTransactionStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum InvoiceType {
  BOOKING
  SUBSCRIPTION
}

enum WebhookProvider {
  STRIPE
  PAYPAL
}

model Payment {
  id                String                   @id @default(uuid())
  organizationId    String?
  reservationId     String?
  subscriptionId    String?
  provider          PaymentProviderCode
  providerReference String?
  status            PaymentTransactionStatus @default(PENDING)
  amount            Decimal                  @db.Decimal(12, 2)
  currency          CurrencyCode
  capturedAmount    Decimal                  @default(0) @db.Decimal(12, 2)
  failureReason     String?
  retryCount        Int                      @default(0)
  nextRetryAt       DateTime?
  metadata          Json?
  initiatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  reservation  Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  refunds Refund[]
  invoice Invoice?

  @@index([organizationId])
  @@index([reservationId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

model Refund {
  id                      String       @id @default(uuid())
  paymentId               String
  amount                  Decimal      @db.Decimal(12, 2)
  reason                  String?
  status                  RefundStatus @default(PENDING)
  providerRefundReference String?
  initiatedByUserId       String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  type           InvoiceType
  organizationId String?
  reservationId  String?       @unique
  subscriptionId String?
  paymentId      String?       @unique
  status         InvoiceStatus @default(DRAFT)
  currency       CurrencyCode

  subtotalAmount   Decimal @db.Decimal(12, 2)
  taxAmount        Decimal @default(0) @db.Decimal(12, 2)
  feeAmount        Decimal @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal @default(0) @db.Decimal(12, 2)
  commissionAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal @db.Decimal(12, 2)

  issuedAt        DateTime?
  dueAt           DateTime?
  billingSnapshot Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  reservation  Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payment      Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  lineItems   InvoiceLineItem[]
  creditNotes CreditNote[]

  @@index([organizationId])
  @@index([status])
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitAmount  Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  kind        String

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model CreditNote {
  id             String  @id @default(uuid())
  invoiceId      String
  creditNumber   String  @unique
  amount         Decimal @db.Decimal(12, 2)
  reason         String
  issuedByUserId String?

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model WebhookLog {
  id              String          @id @default(uuid())
  provider        WebhookProvider
  eventType       String
  providerEventId String?
  payload         Json
  signatureValid  Boolean
  processedAt     DateTime?
  processingError String?

  createdAt DateTime @default(now())

  @@index([provider, eventType])
  @@index([provider, providerEventId])
}

// =========================================================================
// AFFILIATES
// =========================================================================

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

model Affiliate {
  id                String   @id @default(uuid())
  organizationId    String   @unique
  referralCode      String   @unique
  payoutMethod      Json?
  minimumWithdrawal Decimal? @db.Decimal(12, 2)
  holdingPeriodDays Int?
  idDocumentRef     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]
  clicks       AffiliateClick[]
  commissions  Commission[]
  withdrawals  Withdrawal[]

  @@index([referralCode])
}

model Campaign {
  id          String  @id @default(uuid())
  affiliateId String
  name        String
  slug        String
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  affiliate Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  clicks    AffiliateClick[]

  @@unique([affiliateId, slug])
}

model AffiliateClick {
  id                     String  @id @default(uuid())
  affiliateId            String
  campaignId             String?
  visitorId              String
  ipAddressHash          String
  userAgent              String?
  landingPath            String
  convertedReservationId String? @unique

  createdAt DateTime @default(now())

  affiliate   Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  campaign    Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  commissions Commission[]

  @@index([affiliateId, createdAt])
  @@index([visitorId])
}

model AffiliateCommissionRule {
  id             String          @id @default(uuid())
  organizationId String?
  serviceType    ReservationType
  type           CommissionType
  value          Decimal         @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, serviceType])
}

model Commission {
  id              String           @id @default(uuid())
  affiliateId     String
  reservationId   String           @unique
  clickId         String?
  amount          Decimal          @db.Decimal(12, 2)
  currency        CurrencyCode
  rateSnapshot    Decimal          @db.Decimal(12, 4)
  status          CommissionStatus @default(PENDING)
  holdReleaseAt   DateTime?
  rejectionReason String?
  withdrawalId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affiliate   Affiliate       @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  click       AffiliateClick? @relation(fields: [clickId], references: [id], onDelete: SetNull)
  withdrawal  Withdrawal?     @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)

  @@index([affiliateId, status])
}

model Withdrawal {
  id                   String           @id @default(uuid())
  affiliateId          String
  amount               Decimal          @db.Decimal(12, 2)
  currency             CurrencyCode
  status               WithdrawalStatus @default(REQUESTED)
  payoutMethodSnapshot Json
  requestedAt          DateTime         @default(now())
  processedAt          DateTime?
  processedByUserId    String?
  rejectionReason      String?

  affiliate   Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  commissions Commission[]
}

// =========================================================================
// HOTEL DOMAIN
// =========================================================================

model Hotel {
  id                     String         @id @default(uuid())
  organizationId         String
  name                   String
  legalCompanyName       String?
  description            Json
  categoryId             String?
  starRating             Int?
  countryId              String?
  cityId                 String?
  address                String
  mapLat                 Decimal?       @db.Decimal(10, 7)
  mapLng                 Decimal?       @db.Decimal(10, 7)
  phone                  String?
  email                  String?
  website                String?
  checkInTime            String         @default("15:00")
  checkOutTime           String         @default("11:00")
  cancellationPolicyText Json?
  childrenPolicyText     Json?
  petPolicyText          Json?
  parking                Boolean        @default(false)
  breakfast              Boolean        @default(false)
  restaurant             Boolean        @default(false)
  swimmingPool           Boolean        @default(false)
  spa                    Boolean        @default(false)
  gym                    Boolean        @default(false)
  wifi                   Boolean        @default(false)
  airportShuttle         Boolean        @default(false)
