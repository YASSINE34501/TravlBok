  NORMAL
  HIGH
  URGENT
}

// Physical room unit — distinct from RoomType (a sellable category) and from
// RoomAvailabilityOverride (a type-level pricing/closure override). Neither
// existing model can express "guest occupies room 204"; this is purely
// additive and never touches RoomType.availableQuantity, which stays the
// marketplace's overbooking source of truth.
model RoomInventory {
  id                String                @id @default(uuid())
  roomTypeId        String
  hotelId           String
  unitNumber        String
  floor             String?
  operationalStatus RoomOperationalStatus @default(AVAILABLE)
  isActive          Boolean               @default(true)
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  checkIns          CheckIn[]
  housekeepingTasks HousekeepingTask[]
  maintenanceTasks  MaintenanceTask[]
  lostFoundItems    LostFoundItem[]

  @@unique([hotelId, unitNumber])
  @@index([roomTypeId, operationalStatus])
}

