  exchangeRateToBase Decimal?     @db.Decimal(18, 8)
  basePriceAmount    Decimal      @db.Decimal(12, 2)
  taxAmount          Decimal      @default(0) @db.Decimal(12, 2)
  feeAmount          Decimal      @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal      @default(0) @db.Decimal(12, 2)
  commissionAmount   Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal      @db.Decimal(12, 2)

  couponId                   String?
  couponCodeSnapshot         String?
  cancellationPolicySnapshot Json?

  paymentMethod PaymentMethod @default(PAY_AT_PROPERTY)
  paymentStatus PaymentStatus @default(PENDING)

  guestFirstName  String
  guestLastName   String
  guestEmail      String
  guestPhone      String?
  specialRequests String?
  internalNotes   String?

  // Hotel-specific
  hotelId      String?
  checkInDate  DateTime? @db.Date
  checkOutDate DateTime? @db.Date

  // Car-specific
  vehicleId             String?
  pickupAt              DateTime?
  returnAt              DateTime?
  pickupLocation        String?
  dropoffLocation       String?
  driverOptionRequested Boolean?  @default(false)
  gpsRequested          Boolean?  @default(false)
  childSeatRequested    Boolean?  @default(false)
  airportDelivery       Boolean?  @default(false)

  confirmedAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelledReason   String?
  cancelledByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     User         @relation(fields: [customerUserId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  coupon       Coupon?      @relation(fields: [couponId], references: [id])

  hotelLink     HotelReservationLink?
  carLink       CarReservationLink?
  roomItems     ReservationRoomItem[]
  guests        ReservationGuest[]
  review        Review?
  payments      Payment[]
  invoice       Invoice?
  commission    Commission?
  checkIn       CheckIn?
  notes         ReservationNote[]
  channelImport ChannelReservationImport?

  @@index([customerUserId])
  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@index([checkInDate, checkOutDate])
  @@index([pickupAt, returnAt])
  // Composite indexes for Milestone 4's Advanced Analytics rollups, which
  // always filter by organizationId + a createdAt date range (and often
  // hotelId + status + checkInDate for occupancy/ADR/RevPAR) — the existing
  // single-column indexes above already make these correct via bitmap AND,
  // this makes them efficient at "millions of bookings" scale.
  @@index([organizationId, createdAt])
  @@index([hotelId, status, checkInDate])
}

