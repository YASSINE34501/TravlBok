// =========================================================================
// CHANNEL MANAGER
// =========================================================================

enum ChannelProviderCode {
  BOOKING_COM
  EXPEDIA
  AIRBNB
  AGODA
  HOTELS_COM
  VRBO
  MOCK_SANDBOX
}

enum ChannelConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum SyncJobType {
  AVAILABILITY
  RATES
  RESTRICTIONS
  RESERVATION_IMPORT
  FULL
}

enum SyncJobDirection {
  PUSH
  PULL
}

enum SyncJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
  CONFLICT
}

enum SyncLogLevel {
  INFO
  WARN
  ERROR
}

// One connection per (hotel, provider). Credentials are never stored in
// plain text — see src/lib/crypto/secrets.ts (AES-256-GCM). No real
// production API calls are made for any named channel (Booking.com/Expedia/
// Airbnb/Agoda/Hotels.com/Vrbo have no public self-serve API — connecting
// one for real requires a signed partner agreement) — every provider,
// including the always-available MOCK_SANDBOX, runs through a simulated
// adapter until real partner credentials AND an official SDK/API contract
// exist. See src/domains/channel-manager/providers/.
model ChannelConnection {
  id                    String                  @id @default(uuid())
  organizationId        String
  hotelId               String
  provider              ChannelProviderCode
  status                ChannelConnectionStatus @default(DISCONNECTED)
  externalHotelId       String?
  credentialsCiphertext String?
  credentialsIv         String?
  webhookSecret         String                  @default(uuid())
  autoSyncEnabled       Boolean                 @default(false)
  lastSyncedAt          DateTime?
  lastErrorMessage      String?
  connectedAt           DateTime?
  disconnectedAt        DateTime?
  createdByUserId       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hotel        Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  roomMappings       ChannelRoomMapping[]
  syncJobs           SyncJob[]
  reservationImports ChannelReservationImport[]

  @@unique([hotelId, provider])
  @@index([organizationId])
}

model ChannelRoomMapping {
  id                  String  @id @default(uuid())
  channelConnectionId String
  roomTypeId          String
  externalRoomId      String
  externalRatePlanId  String?
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channelConnection ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  roomType          RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([channelConnectionId, roomTypeId])
  @@index([channelConnectionId])
}

model SyncJob {
  id                  String           @id @default(uuid())
  channelConnectionId String
  type                SyncJobType
  direction           SyncJobDirection
  status              SyncJobStatus    @default(PENDING)
  triggeredByUserId   String?
  itemsProcessed      Int              @default(0)
  itemsFailed         Int              @default(0)
  summary             Json?
  errorMessage        String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  channelConnection ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  logEntries        SyncLogEntry[]

  @@index([channelConnectionId, status])
  @@index([startedAt])
}

model SyncLogEntry {
  id        String       @id @default(uuid())
  syncJobId String
  level     SyncLogLevel
  message   String
  metadata  Json?

  createdAt DateTime @default(now())

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
}

// The idempotency/duplicate-booking-prevention mechanism: unique on
// (channelConnectionId, externalReservationId), so re-processing the same
// external booking (retry, duplicate webhook delivery) can never create a
// second Reservation.
model ChannelReservationImport {
  id                    String  @id @default(uuid())
  channelConnectionId   String
  externalReservationId String
  reservationId         String? @unique
  rawPayload            Json
  hasConflict           Boolean @default(false)
  conflictNotes         String?

  importedAt DateTime @default(now())

  channelConnection ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  reservation       Reservation?      @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([channelConnectionId, externalReservationId])
  @@index([channelConnectionId])
}

// =========================================================================
// DYNAMIC PRICING
// =========================================================================

enum PricingRuleFactor {
  SEASON
  DAY_OF_WEEK
  WEEKEND
  HOLIDAY
  SPECIAL_EVENT
  OCCUPANCY
  REMAINING_INVENTORY
  BOOKING_WINDOW
  LENGTH_OF_STAY
  DEMAND_LEVEL
}

enum PricingComparisonOperator {
  GTE
  LTE
}

enum PricingAdjustmentType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DemandLevel {
  LOW
  MEDIUM
  HIGH
}

enum PricingRuleApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PriceLogSource {
  LIVE
  RECALCULATED
}

// A rule-based (no external AI) nightly-price adjustment. Each rule tests one
// MASTER-PLAN "price factor" (PricingRuleFactor) against the night being
// priced and applies one adjustment. Active + approved rules for a RoomType
// (plus hotel-wide rules where roomTypeId is null) stack in `priority` order
// (ascending); the combined result is always clamped to RoomType.minPrice/
// maxPrice — MASTER-PLAN's "never breach min/max" — enforced centrally in
// src/domains/dynamic-pricing/engine.ts, not per rule.
model PricingRule {
  id          String  @id @default(uuid())
  hotelId     String
  roomTypeId  String? // null = applies to every room type in the hotel
  name        String
  description String?

  factor             PricingRuleFactor
  comparisonOperator PricingComparisonOperator?
  thresholdValue     Decimal?                   @db.Decimal(8, 2)
  daysOfWeek         Int[]                      @default([])
  dateRangeStart     DateTime?                  @db.Date
  dateRangeEnd       DateTime?                  @db.Date
  demandLevel        DemandLevel?

  adjustmentType  PricingAdjustmentType
  adjustmentValue Decimal               @db.Decimal(8, 2)

  priority   Int       @default(0)
  isActive   Boolean   @default(true)
  activeFrom DateTime?
  activeTo   DateTime?

  requiresApproval Boolean                   @default(false)
  approvalStatus   PricingRuleApprovalStatus @default(APPROVED)
  approvedById     String?
  approvedAt       DateTime?

  createdById String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  hotel      Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("PricingRuleCreatedBy", fields: [createdById], references: [id])
  approvedBy User?     @relation("PricingRuleApprovedBy", fields: [approvedById], references: [id])

  @@index([hotelId, isActive])
  @@index([roomTypeId])
}

// Materialized per-night pricing calendar / history — written whenever the
// engine actually prices a night for a real booking (LIVE) or via the
// forward-looking recalculation action (RECALCULATED). Powers the pricing
// calendar, price history, and revenue-comparison/forecast views without
// re-running rule evaluation retroactively.
model DynamicPriceLog {
  id                   String         @id @default(uuid())
  roomTypeId           String
  date                 DateTime       @db.Date
  basePrice            Decimal        @db.Decimal(12, 2)
  finalPrice           Decimal        @db.Decimal(12, 2)
  appliedRuleIds       String[]       @default([])
  occupancyRatePercent Decimal?       @db.Decimal(5, 2)
  remainingInventory   Int?
  source               PriceLogSource @default(LIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([roomTypeId, date])
}

// =========================================================================
// SECURITY (Phase 3)
// =========================================================================

// Generic, DB-backed fixed-window rate limiter (see src/lib/rate-limit.ts).
// Deliberately not Redis-backed yet — matches this app's existing
// "Redis-ready architecture" placeholder pattern (Phase 3 Performance/Scale);
// swapping to Redis later means replacing this model's single call site,
// not every caller.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// Partner-facing API key management ("API key management" per MASTER-PLAN).
// No public REST surface is built against these yet (same honest-scaffold
// reasoning as Channel Manager's providers/webhook route) — issuing and
// revoking keys is real; a caller only needs to check this table.
model ApiKey {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  keyPrefix       String
  hashedKey       String    @unique
  lastUsedAt      DateTime?
  createdByUserId String
  revokedAt       DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId])
}
